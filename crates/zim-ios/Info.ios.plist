<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the debug build reach a hub on the host's loopback
	     (http://127.0.0.1:<port>); remote hosts stay HTTPS-only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- A dev build (`make ios-ipa-dev`) loads a hub on the developer's
	     Mac over Wi-Fi; iOS asks once before allowing that. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Zim connects to a zim hub running on your local network.</string>
	<!-- The hub hands a finished sign-in back to zim-auth://callback. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.krondor.zim.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zim-auth</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
