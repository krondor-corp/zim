#!/usr/bin/env bash
# Build the Yew SPA (crates/zim-hub/web) into web/dist, which the hub
# serves under /app.
#
# This MUST run before launching the hub, every time — otherwise the hub
# serves whatever stale bundle happens to be on disk (the bug that ate a
# whole afternoon). It can't live in the hub's build.rs: trunk shells out
# to cargo, and a nested cargo invocation deadlocks on the outer build's
# lock. So it's its own step, called from bin/hub, the dev harness, and
# the Makefile.
#
# Usage:
#   ./bin/build-web            # debug build into web/dist
#   ./bin/build-web --release  # optimized bundle
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB_DIR="$PROJECT_ROOT/crates/zim-hub/web"

if ! command -v trunk >/dev/null 2>&1; then
    echo "Error: trunk not installed. Run: cargo install trunk" >&2
    exit 1
fi

echo "Building web SPA (trunk)…" >&2
(cd "$WEB_DIR" && trunk build "$@" >&2)

# Surface the bundle hash so a stale browser cache is obvious at a glance.
bundle="$(grep -oE 'zim-hub-web-[a-f0-9]+\.js' "$WEB_DIR/dist/index.html" 2>/dev/null | head -1 || true)"
[ -n "$bundle" ] && echo "web SPA built: $bundle" >&2
