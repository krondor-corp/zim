#!/usr/bin/env bash
# Manage the dev S3 blob store: one container, docker OR podman.
#
# The server is RustFS (https://rustfs.com), a MinIO-compatible S3
# implementation. MinIO itself pulled its public images from Docker Hub
# and Quay in 2026, so `minio/minio:latest` no longer resolves; RustFS
# serves the same API on the same ports (9000 S3, 9001 console) and
# honours the same path-style requests the hub's `object_store` client
# sends. Names below keep the `minio` spelling so existing env vars,
# the `zim-minio` container, and the `./bin/minio` entry point still
# work; only the image changed.

set -o errexit
set -o nounset

# Get project root (parent of bin directory)
PROJECT_ROOT="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." && pwd )"

# confit is a required dev tool (like cargo): it owns the dev port map
# (confit.toml `[ports]`) and the styled log lines below.
if ! command -v confit &>/dev/null; then
    printf 'confit not installed (required, like cargo). Install:\n' >&2
    printf '  curl -fsSL https://raw.githubusercontent.com/krondor-corp/confit/main/install.sh | bash\n' >&2
    exit 1
fi

# Styled output helpers; the ERRORS tally drives exit codes for
# multi-step commands.
log()  { confit log "$*"; }
ok()   { confit log --ok "$*"; }
err()  { confit log --err "$*"; }
ERRORS=0
print_header() { log "=== $1 ==="; }
check_result() {
    local rc=$?
    if [ $rc -eq 0 ]; then ok "$1 passed"
    else err "$1 failed"; ERRORS=$((ERRORS + 1)); fi
}
print_summary() {
    print_header "Summary"
    if [ $ERRORS -eq 0 ]; then ok "$1"; return 0
    else err "$ERRORS ${2:-check(s) failed}"; return 1; fi
}

# Configuration
PROJECT_NAME="zim"
MINIO_CONTAINER_NAME="${PROJECT_NAME}-minio"
MINIO_VOLUME_NAME="${PROJECT_NAME}-minio-data"
# Ports are confit.toml's `ports.infra.*`: the same on every branch, so
# every worktree shares this one container (each hub gets its own
# bucket — see `bucket`). They live in the project's 171xx band so
# nothing collides with common services (minio's native 9000 is
# ClickHouse's port, for one). Band map: confit.toml.
MINIO_API_PORT=${MINIO_API_PORT:-$(cd "$PROJECT_ROOT" && confit resolve ports.infra.minio_api)}
MINIO_CONSOLE_PORT=${MINIO_CONSOLE_PORT:-$(cd "$PROJECT_ROOT" && confit resolve ports.infra.minio_console)}
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Fully-qualified so podman doesn't prompt for a registry.
MINIO_IMAGE_NAME="${MINIO_IMAGE_NAME:-docker.io/rustfs/rustfs:latest}"
MINIO_BUCKET_NAME="${PROJECT_NAME}-blobs"

# Pick a container runtime. `ZIM_CONTAINER_RUNTIME` forces one;
# otherwise we prefer **podman** (its CoreOS VM runs chrony and doesn't
# suffer Docker Desktop's post-sleep clock drift, which makes minio's
# S3 signatures fail with RequestTimeTooSkewed). We pick whichever
# actually responds first (`<runtime> ps` succeeding means the binary
# exists AND its daemon/machine is up — a stopped podman shouldn't
# shadow a running docker). Fall back to whichever binary merely exists
# so the error message in check_runtime names something sensible.
# Run a command with a time bound so a wedged daemon (e.g. Docker Desktop
# mid-start, where `docker ps` hangs forever instead of erroring) can't
# stall the whole script. Uses `timeout`/`gtimeout` when present; degrades
# to running bare (original behaviour) where neither exists.
function bounded {
    local secs="$1"; shift
    if command -v timeout &>/dev/null; then timeout "$secs" "$@"
    elif command -v gtimeout &>/dev/null; then gtimeout "$secs" "$@"
    else "$@"
    fi
}

function pick_runtime {
    if [[ -n "${ZIM_CONTAINER_RUNTIME:-}" ]]; then
        echo "$ZIM_CONTAINER_RUNTIME"
        return
    fi
    for rt in podman docker; do
        if command -v "$rt" &>/dev/null && bounded 5 "$rt" ps &>/dev/null; then
            echo "$rt"
            return
        fi
    done
    for rt in podman docker; do
        if command -v "$rt" &>/dev/null; then
            echo "$rt"
            return
        fi
    done
    echo "podman"
}
CONTAINER_RUNTIME="$(pick_runtime)"

# Detect OS and set network flags accordingly
OS_TYPE=$(uname -s)
NETWORK_FLAGS=""
if [[ "$OS_TYPE" == "Linux" ]]; then
    NETWORK_FLAGS="--network host"
elif [[ "$OS_TYPE" == "Darwin" ]]; then
    # macOS uses bridge networking (default)
    NETWORK_FLAGS=""
fi

# Verify the chosen runtime is actually usable
function check_runtime {
    if ! bounded 5 $CONTAINER_RUNTIME ps &>/dev/null; then
        err "Error: no working container runtime."
        echo "  tried: $CONTAINER_RUNTIME (install/start docker or podman," >&2
        echo "  or force one with ZIM_CONTAINER_RUNTIME=docker)" >&2
        exit 1
    fi
}

# Start local MinIO for development
function up {
    check_runtime

    print_header "Starting MinIO"

    # Check if container exists (running or stopped)
    if $CONTAINER_RUNTIME ps -a --format '{{.Names}}' | grep -q "^${MINIO_CONTAINER_NAME}$"; then
        # A container created before a port change keeps its old
        # bind address forever — recreate it (the data volume survives).
        if ! $CONTAINER_RUNTIME inspect --format '{{range .Config.Env}}{{println .}}{{end}}' $MINIO_CONTAINER_NAME 2>/dev/null \
            | grep -qx "RUSTFS_ADDRESS=:${MINIO_API_PORT}"; then
            log "Container doesn't listen on :$MINIO_API_PORT — recreating (volume kept)..."
            $CONTAINER_RUNTIME rm -f $MINIO_CONTAINER_NAME >/dev/null
        # Container exists - check if it's running
        elif $CONTAINER_RUNTIME ps --format '{{.Names}}' | grep -q "^${MINIO_CONTAINER_NAME}$"; then
            ok "MinIO container is already running."
            verify_connection
            ensure_bucket
            return 0
        else
            # Container exists but is stopped - start it
            echo "Starting existing MinIO container..."
            $CONTAINER_RUNTIME start $MINIO_CONTAINER_NAME
            sleep 3
            verify_connection
            ensure_bucket

            echo ""
            ok "MinIO started!"
            show_connection_info
            return 0
        fi
    fi

    # Container doesn't exist - create and start it
    echo "Creating new MinIO container..."
    start_minio_container

    # Wait for MinIO to be ready
    log "Waiting for MinIO to be ready..."
    sleep 3

    # Verify network connectivity to container
    verify_connection
    ensure_bucket

    echo ""
    ok "MinIO started!"
    show_connection_info
}

# Helper function to display connection information
function show_connection_info {
    echo ""
    log "Set environment variables:"
    echo "  export MINIO_ENDPOINT=http://localhost:${MINIO_API_PORT}"
    echo "  export MINIO_ROOT_USER=${MINIO_ROOT_USER}"
    echo "  export MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}"
    echo ""
    log "MinIO Console (Web UI):"
    echo "  http://localhost:${MINIO_CONSOLE_PORT}"
    echo ""
    log "S3 API Endpoint:"
    echo "  http://localhost:${MINIO_API_PORT}"
    echo ""
    log "S3 URL for zim init:"
    echo "  s3://minioadmin:minioadmin@localhost:${MINIO_API_PORT}/zim-blobs"
}

# Verify connection to MinIO
function verify_connection {
    log "Verifying container status..."
    $CONTAINER_RUNTIME logs --tail 10 $MINIO_CONTAINER_NAME

    echo "Testing connection from host to container..."
    if command -v curl &>/dev/null; then
        if curl -f -s -o /dev/null http://localhost:${MINIO_API_PORT}/health; then
            ok "API connection successful!"
        else
            err "API connection test failed. See troubleshooting tips below."
            show_troubleshooting
        fi
    else
        log "curl not found. Install curl to test connectivity."
        show_troubleshooting
    fi
}

# Signed S3 request against the dev store from the host. curl's native
# SigV4 means no `mc`/`aws` CLI and nothing exec'd inside the container,
# so this is identical under docker and podman. Prints the HTTP status.
function s3 {
    local method="$1" path="$2"; shift 2
    curl -s -o /dev/null -w '%{http_code}' -X "$method" \
        --aws-sigv4 "aws:amz:us-east-1:s3" \
        --user "$MINIO_ROOT_USER:$MINIO_ROOT_PASSWORD" \
        "$@" "http://localhost:${MINIO_API_PORT}${path}"
}

# Ensure a bucket exists (default: zim-blobs).
function ensure_bucket {
    local bucket="${1:-$MINIO_BUCKET_NAME}"
    echo "Ensuring bucket '${bucket}' exists..."
    local code
    code=$(s3 HEAD "/${bucket}")
    if [[ "$code" == "200" ]]; then
        ok "Bucket '${bucket}' already exists."
        return 0
    fi
    code=$(s3 PUT "/${bucket}")
    if [[ "$code" == "200" ]]; then
        ok "Created bucket '${bucket}'."
    else
        err "Could not create bucket '${bucket}' (HTTP $code)."
        exit 1
    fi
}

# Create a bucket in the running store. `./bin/dev hub up` uses this
# for its per-worktree bucket (zim-blobs-<branch slug>).
function bucket {
    if [[ -z "${1:-}" ]]; then
        err "usage: $0 bucket <name>"
        exit 1
    fi
    check_runtime
    ensure_bucket "$1"
}

# List the objects in a bucket (default zim-blobs): what a hub has mirrored.
function ls {
    check_runtime
    local bucket="${1:-$MINIO_BUCKET_NAME}"
    curl -s --aws-sigv4 "aws:amz:us-east-1:s3" \
        --user "$MINIO_ROOT_USER:$MINIO_ROOT_PASSWORD" \
        "http://localhost:${MINIO_API_PORT}/${bucket}?list-type=2" \
        | grep -oE '<Key>[^<]+</Key>' | sed -E 's#</?Key>##g'
}

# Helper function to show troubleshooting tips
function show_troubleshooting {
    echo ""
    print_header "Troubleshooting Tips"
    echo "1. Is the runtime up? docker: Docker Desktop running; podman: 'podman machine start'"
    echo "2. Force a runtime: ZIM_CONTAINER_RUNTIME=docker (or podman) $0 up"
    echo "3. Check if another service is using ports $MINIO_API_PORT or $MINIO_CONSOLE_PORT:"
    echo "   lsof -i :$MINIO_API_PORT"
    echo "   lsof -i :$MINIO_CONSOLE_PORT"
    echo "4. Container logs: $CONTAINER_RUNTIME logs $MINIO_CONTAINER_NAME"
    echo ""
}

# Helper function to create and start a new MinIO container
function start_minio_container {
    # Pull only when the image isn't already local — keeps `up` working
    # offline and avoids a registry round-trip on every start.
    if ! $CONTAINER_RUNTIME image inspect "$MINIO_IMAGE_NAME" >/dev/null 2>&1; then
        $CONTAINER_RUNTIME pull "$MINIO_IMAGE_NAME"
    fi
    $CONTAINER_RUNTIME volume create $MINIO_VOLUME_NAME || true

    # The server binds the dev ports itself (not its native 9000/9001):
    # Linux runs with `--network host`, where `--publish` is ignored, so
    # a remap would leave it on 9000. Publishing port-to-port keeps
    # bridge networking (macOS) working the same way.
    $CONTAINER_RUNTIME run \
        --name $MINIO_CONTAINER_NAME \
        $NETWORK_FLAGS \
        --publish $MINIO_API_PORT:$MINIO_API_PORT \
        --publish $MINIO_CONSOLE_PORT:$MINIO_CONSOLE_PORT \
        --volume $MINIO_VOLUME_NAME:/data \
        --env RUSTFS_ADDRESS=:$MINIO_API_PORT \
        --env RUSTFS_CONSOLE_ADDRESS=:$MINIO_CONSOLE_PORT \
        --env RUSTFS_ACCESS_KEY=$MINIO_ROOT_USER \
        --env RUSTFS_SECRET_KEY=$MINIO_ROOT_PASSWORD \
        --health-cmd="curl -f http://localhost:$MINIO_API_PORT/health || exit 1" \
        --health-interval=5s \
        --health-timeout=5s \
        --health-retries=5 \
        --detach \
        $MINIO_IMAGE_NAME
}

function down {
    check_runtime
    print_header "Cleaning MinIO Container"

    echo "Stopping MinIO container..."
    $CONTAINER_RUNTIME stop $MINIO_CONTAINER_NAME 2>/dev/null || true
    check_result "Container stop"

    echo "Removing MinIO container..."
    $CONTAINER_RUNTIME rm -f $MINIO_CONTAINER_NAME 2>/dev/null || true
    check_result "Container removal"

    echo "Removing MinIO volume..."
    $CONTAINER_RUNTIME volume rm -f $MINIO_VOLUME_NAME 2>/dev/null || true
    check_result "Volume removal"

    print_summary "MinIO cleaned up successfully!" "cleanup step(s) failed"
}

function endpoint {
    check_runtime
    if $CONTAINER_RUNTIME ps -a | grep $MINIO_CONTAINER_NAME &>/dev/null; then
        echo "http://localhost:${MINIO_API_PORT}"
    else
        err "MinIO container is not running. Start it with: $0 up"
        exit 1
    fi
}

function console {
    check_runtime
    if $CONTAINER_RUNTIME ps | grep -q "$MINIO_CONTAINER_NAME"; then
        local console_url="http://localhost:${MINIO_CONSOLE_PORT}"
        ok "Opening MinIO Console..."
        echo "URL: $console_url"
        echo "Username: $MINIO_ROOT_USER"
        echo "Password: $MINIO_ROOT_PASSWORD"

        # Try to open in browser
        if command -v xdg-open &>/dev/null; then
            xdg-open "$console_url" 2>/dev/null || true
        elif command -v open &>/dev/null; then
            open "$console_url" 2>/dev/null || true
        else
            log "Please open the URL manually in your browser"
        fi
    else
        err "MinIO container is not running. Start it with: $0 up"
        exit 1
    fi
}

function status {
    check_runtime
    print_header "MinIO Status"

    if $CONTAINER_RUNTIME ps | grep -q "$MINIO_CONTAINER_NAME"; then
        ok "MinIO container is running."
        echo ""
        log "Recent logs:"
        $CONTAINER_RUNTIME logs --tail 20 $MINIO_CONTAINER_NAME
        echo ""

        if command -v curl &>/dev/null; then
            log "Connection status:"
            if curl -f -s -o /dev/null http://localhost:${MINIO_API_PORT}/health; then
                ok "API connection active"
                ok "Console available at http://localhost:${MINIO_CONSOLE_PORT}"
            else
                err "Connection failed"
            fi
        fi
    else
        err "MinIO container is not running."
        echo ""
        echo "Start it with: $0 up"
    fi
}

function help {
    log "Dev S3 blob store (RustFS, MinIO-compatible) — docker or podman"
    echo ""
    echo "Usage: $0 [command]"
    echo ""
    echo "Commands:"
    echo "  up                 - Start the blob store container (pulls the image once)"
    echo "  down               - Remove the container and its volume"
    echo "  endpoint           - Print the S3 API endpoint URL"
    echo "  console            - Open the web console in a browser"
    echo "  status             - Check container status and connection"
    echo "  bucket <name>      - Create a bucket (hub up: one per worktree)"
    echo "  ls [bucket]        - List objects in a bucket (default ${MINIO_BUCKET_NAME};"
    echo "                       a worktree's hub uses the one in ./bin/dev ports)"
    echo "  help               - Show this help message"
    echo ""
    echo "Runtime: podman preferred, docker otherwise; force with ZIM_CONTAINER_RUNTIME."
    echo "Image: \$MINIO_IMAGE_NAME (default docker.io/rustfs/rustfs:latest)."
    echo "Default credentials: minioadmin / minioadmin"
    echo ""
    echo "Example usage with zim:"
    echo "  $0 up"
    echo "  zim init --blob-store s3 --s3-url \"s3://minioadmin:minioadmin@localhost:${MINIO_API_PORT}/zim-blobs\""
}

# Process command
CMD=${1:-help}
shift || true  # Shift to remove command from arguments

case "$CMD" in
up | down | endpoint | console | status | bucket | ls | help)
    $CMD "$@"
    ;;
*)
    err "Unknown command: $CMD"
    help
    exit 1
    ;;
esac
