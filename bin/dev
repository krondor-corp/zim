#!/bin/bash
#
# Zim development environment
#
# Spawns multiple `zim daemon` instances in tmux, each with its own
# $ZIM_HOME and port, so you can drive a multi-peer setup from one
# terminal.
#
# Usage:
#   ./bin/dev                  Start all daemons in tmux (attaches)
#   ./bin/dev run -b           Start in background
#   ./bin/dev clean            Remove all dev data
#   ./bin/dev kill             Kill the tmux session
#   ./bin/dev kill --force     Kill + also free any ports left dangling
#   ./bin/dev status           Show which daemons are up
#   ./bin/dev cli <nick> ...   Run `zim` against a specific node's daemon
#   ./bin/dev logs <nick>      Dump that node's tmux pane
#   ./bin/dev help

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DATA_DIR="$PROJECT_ROOT/data"
DEV_DIR="$SCRIPT_DIR/dev_"
CONFIG_FILE="$DEV_DIR/nodes.toml"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

source "$DEV_DIR/config.sh"
source "$DEV_DIR/nodes.sh"
source "$DEV_DIR/hub.sh"
source "$DEV_DIR/seed.sh"
source "$DEV_DIR/fixtures.sh"
source "$DEV_DIR/e2e.sh"

cmd_help() {
    cat <<EOF
Zim development environment

Usage: ./bin/dev <command> [args...]

Commands:
  run [-b|--background]   Start all daemons in tmux (default; attaches)
      [--fuse]            ...with the \`fuse\` feature so \`zim mount\` works
      [--hub]            ...then start the hub, seed fixtures, and enroll
                          the daemons — the whole stack in one command
                          (\`./bin/dev --hub\` works too). Needs docker.
  clean                   Remove all data under $DATA_DIR
  kill [-f|--force]       Kill the tmux session; -f also frees ports
  status                  Show which daemons are up
  attach | a              Attach to the tmux session (detach: Ctrl-b d)
  cli <nick> <args...>    Run \`zim\` against a node's daemon
  shell                   Emit \`alice\`/\`bob\`/... shell functions
                          (\`eval "\$(./bin/dev shell)"\` to activate)
  logs <nick> [-f]        Tail that node's clean daemon.log (-f follows)
  seed                    Peer plumbing + apply fixtures.toml (vaults,
                          shares, FUSE checks; no hub/docker needed)
  fixtures [apply|list]   Apply (or list) the declarative fixtures in
                          bin/dev_/fixtures.toml
  fuse-check              Report whether FUSE fixtures will run here
  e2e                     One-shot e2e run: clean → daemons → fixtures →
                          cross-node sync checks → PASS/FAIL exit code
  hub [up|enroll|did|down]
                          Run zim-hub in a tmux window (real OAuth via
                          confit + minio; needs docker). \`enroll\` seeds
                          the hub user + enrolls dev daemons (stands in
                          for \`zim login\`). \`did\` prints its did:web.
  help                    Show this help

Examples:
  ./bin/dev                            # start dev environment
  ./bin/dev --hub                      # full stack: daemons + hub + fixtures
  ./bin/dev run --background           # start in background
  ./bin/dev cli alice id               # show alice's pubkey
  ./bin/dev cli alice init             # bootstrap alice's peer state
  echo hi | ./bin/dev cli alice vault add demo /readme.md
  ./bin/dev status

  # Or: lift to direct per-peer commands in the current shell.
  eval "\$(./bin/dev shell)"
  alice health
  bob vault list

Node config: $CONFIG_FILE
EOF
}

case "${1:-run}" in
    help|-h|--help) cmd_help ;;
    run)            shift; cmd_run "$@" ;;
    clean)          cmd_clean ;;
    kill)           shift; cmd_kill "$@" ;;
    status)         cmd_status ;;
    attach|a)       cmd_attach ;;
    cli)            shift; cmd_cli "$@" ;;
    shell)          cmd_shell ;;
    logs)           shift; cmd_logs "$@" ;;
    hub)            shift; cmd_hub "$@" ;;
    seed)           cmd_seed ;;
    fixtures)       shift; cmd_fixtures "$@" ;;
    fuse-check)     shift; cmd_fuse_check "$@" ;;
    e2e)            shift; cmd_e2e "$@" ;;
    # Bare flags (e.g. `./bin/dev --hub`, `--fuse`, `-b`) → run.
    -*)             cmd_run "$@" ;;
    *)              echo -e "${RED}Unknown command: $1${NC}"; cmd_help; exit 1 ;;
esac
