#!/usr/bin/env bash
#
# Uninstall `zim` from ~/.cargo/bin.
#
# Usage:
#   ./bin/uninstall              remove the binary (cargo uninstall + rm
#                                 the dev symlink if it exists)
#   ./bin/uninstall --purge      also delete $ZIM_HOME (default ~/.zim)
#
# Does NOT touch data unless you pass --purge.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

CARGO_BIN="${CARGO_HOME:-$HOME/.cargo}/bin"
TARGET="$CARGO_BIN/zim"
DEFAULT_HOME="$HOME/.zim"

purge=false
for arg in "$@"; do
    case "$arg" in
        --purge) purge=true ;;
        -h|--help)
            sed -n '2,11p' "$0" | sed 's|^# \?||'
            exit 0
            ;;
        *) echo -e "${RED}Unknown flag: $arg${NC}"; exit 1 ;;
    esac
done

if [[ -L "$TARGET" ]]; then
    rm -f "$TARGET"
    echo -e "${GREEN}Removed dev symlink:${NC} $TARGET"
elif [[ -x "$TARGET" ]]; then
    cargo uninstall zim 2>/dev/null || rm -f "$TARGET"
    echo -e "${GREEN}Removed:${NC} $TARGET"
else
    echo -e "${YELLOW}Nothing at:${NC} $TARGET"
fi

if $purge; then
    zim_home="${ZIM_HOME:-$DEFAULT_HOME}"
    if [[ -d "$zim_home" ]]; then
        rm -rf "$zim_home"
        echo -e "${GREEN}Purged:${NC} $zim_home"
    fi
fi
