# Zim — example environment variables.
# Copy to `.env` and edit; `.env` is gitignored. The Makefile reads from your
# shell environment, so `source .env` (or use direnv) before running `make hub`.

# --- zim-hub (read-only web mirror gateway) ---

# Address the hub HTTP server binds to. Default: 127.0.0.1:8080.
ZIM_HUB_LISTEN=127.0.0.1:8080

# Base URL of the local zim-peer daemon the hub reads from. Default: http://127.0.0.1:3001.
ZIM_HUB_PEER=http://127.0.0.1:3001

# zim-hub-only log level (info, debug, trace, warn, error). Default: info.
ZIM_HUB_LOG=info

# Tracing-subscriber filter. Overrides ZIM_HUB_LOG and the Makefile default.
# RUST_LOG=info,zim_hub=debug
