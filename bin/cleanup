#!/usr/bin/env bash
# Nuke stale build artifacts to free disk.
#
# Usage:
#   ./bin/cleanup           # cargo target + wiki site/vendor (safe)
#   ./bin/cleanup --all     # also dev data (./data/) and minio state
#   ./bin/cleanup --dry-run # show what would be removed, do nothing
set -eu

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

DRY=false
ALL=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY=true ;;
    --all)     ALL=true ;;
    -h|--help)
      sed -n 's/^# //p' "$0" | head -8
      exit 0
      ;;
    *) echo "Unknown flag: $arg" >&2; exit 1 ;;
  esac
done

run() {
  if $DRY; then
    echo "  [dry-run] $*"
  else
    echo "  $*"
    "$@"
  fi
}

echo "==> Cargo target"
run cargo clean

echo "==> Wiki build artefacts"
[ -d wiki/_site ]   && run rm -rf wiki/_site
[ -d wiki/vendor ]  && run rm -rf wiki/vendor
[ -f wiki/Gemfile.lock ] && run rm -f wiki/Gemfile.lock
[ -d wiki/.jekyll-cache ] && run rm -rf wiki/.jekyll-cache

if $ALL; then
  echo "==> Dev data (./data/)"
  [ -d data ] && run rm -rf data

  echo "==> MinIO local state"
  [ -d .minio ] && run rm -rf .minio
fi

if $DRY; then
  echo
  echo "Dry run only — no files removed."
else
  echo
  echo "Cleanup complete."
fi
