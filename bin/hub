#!/usr/bin/env bash
# Launch zim-hub with OAuth credentials resolved via confit.
#
# Uses `confit env credentials.app --export --upper` so the section's
# keys arrive as the GOOGLE_O_AUTH_CLIENT_ID / _SECRET env vars the
# hub binary reads (same names as krondor-corp/generic's rust app).
#
# Usage:
#   ./bin/hub                        # debug build, port 8080
#   ZIM_HUB_LISTEN=:9000 ./bin/hub   # override any zim-hub env var

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

if ! command -v confit >/dev/null 2>&1; then
    echo "Error: confit not installed. Run:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/krondor-corp/confit/main/install.sh | bash" >&2
    exit 1
fi

# Dev blob store: the minio container from bin/minio. Idempotent —
# `up` no-ops when it's already running, creates the zim-blobs
# bucket either way.
"$PROJECT_ROOT/bin/minio" up >/dev/null || {
    echo "Error: minio failed to start — is docker running?" >&2
    exit 1
}

# Sensible defaults for zim-hub's own knobs. Anything already set in
# the parent shell wins.
: "${ZIM_HUB_LISTEN:=127.0.0.1:8080}"
: "${ZIM_HUB_HOME:=$PROJECT_ROOT/data/zim-hub}"
: "${ZIM_HUB_ADMIN_EMAILS:=al@krondor.org}"
: "${ZIM_HUB_S3_ENDPOINT:=http://localhost:9000}"
: "${ZIM_HUB_S3_ACCESS_KEY:=minioadmin}"
: "${ZIM_HUB_S3_SECRET_KEY:=minioadmin}"
: "${ZIM_HUB_S3_BUCKET:=zim-blobs}"
export ZIM_HUB_LISTEN ZIM_HUB_HOME ZIM_HUB_ADMIN_EMAILS
export ZIM_HUB_S3_ENDPOINT ZIM_HUB_S3_ACCESS_KEY ZIM_HUB_S3_SECRET_KEY ZIM_HUB_S3_BUCKET

cargo build --bin zim-hub

# `confit run credentials.app --upper` resolves GOOGLE_O_AUTH_CLIENT_ID
# and GOOGLE_O_AUTH_CLIENT_SECRET from 1Password and injects them into
# the child env before exec'ing the binary.
exec confit run credentials.app --upper -- ./target/debug/zim-hub "$@"
